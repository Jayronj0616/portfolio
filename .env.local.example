# Copy this file to .env.local and fill in the values from your
# Supabase project (Project Settings -> API).

# Safe to expose to the browser (used for public reads only; RLS
# limits it to SELECT on projects/testimonials, see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_. Used by Server
# Actions to write contact messages and analytics events.
SUPABASE_SERVICE_ROLE_KEY=
